# Falcon AI — the ONE committed env example. Fake values only.
# Copy to the env file of the environment you run:
#   .env.development  → docker-compose.dev.yml   (make dev-up)
#   .env.staging      → docker-compose.staging.yml (make staging-up)
#   .env.production   → docker-compose.prod.yml    (make prod-up)
# The staging compose file mirrors production verbatim; only these values differ.
# Variables marked [dev only] are ignored by staging/production.

# ── App (Rust-Backend-Build-Template §13) ─────────────────────────────
APP_ENV=development                      # development | staging | production
PORT=8080                                # port the API listens on INSIDE its container
LOG_LEVEL=info                           # tracing filter, e.g. info or falcon_api=debug,info
SHUTDOWN_WAIT_SECS=10
DB_MAX_CONNS=10

# ── Host port mapping — ports appear ONLY in env files (Vite template Rule 7) ──
API_PORT=CHANGE_ME_API_HOST_PORT         # host side of the API container
FRONTEND_PORT=CHANGE_ME_FRONTEND_HOST_PORT
VITE_DEV_PORT=CHANGE_ME_DEV_SERVER_PORT  # [dev only] Vite dev server port inside its container
POSTGRES_PORT=CHANGE_ME_DB_HOST_PORT     # [dev only] Postgres on 127.0.0.1 for local DB tools

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_DB=falcon
POSTGRES_USER=falcon
POSTGRES_PASSWORD=change_me_strong_password
# Host is the compose service name `postgres`; must match the three values above.
DATABASE_URL=postgres://falcon:change_me_strong_password@postgres:5432/falcon

# ── HTTP (Rust-Backend-Build-Template §13, §21) ───────────────────────
CORS_ORIGINS=http://localhost:CHANGE_ME_FRONTEND_HOST_PORT   # comma-separated web app origins; also the allowed Clerk `azp`

# ── Auth: Clerk (Matt, 2026-11-18) ────────────────────────────────────
# Development keys come from `npx -y clerk@latest env pull`; production keys from `clerk deploy`.
CLERK_ISSUER=https://CHANGE_ME.clerk.accounts.dev              # Clerk Frontend API URL; the API trusts tokens from it
CLERK_SECRET_KEY=sk_test_CHANGE_ME                               # server-side only; never in VITE_* or the browser

# ── Web app — PUBLIC, baked into the JS bundle at build time. Never secrets.
# (Vite-Build-Template §10)
VITE_API_BASE_URL=http://localhost:CHANGE_ME_API_HOST_PORT/api
VITE_APP_NAME=Falcon AI
VITE_ENVIRONMENT=development             # development | production (staging uses production)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_CHANGE_ME                    # public Clerk key, baked into the bundle
