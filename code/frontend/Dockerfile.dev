# syntax=docker/dockerfile:1
# Vite-Build-Template §11.1 — Vite dev server + HMR.
# `npm ci` needs package-lock.json; the lockfile is created by the owner's first
# local `npm install` and committed.
FROM node:20-alpine

WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

# Source volume-mounted at runtime for hot reload
ARG VITE_DEV_PORT
ENV VITE_DEV_PORT=${VITE_DEV_PORT}
EXPOSE ${VITE_DEV_PORT}

# Reliable file-watching inside containers
ENV CHOKIDAR_USEPOLLING=true

CMD ["sh", "-c", "npm run dev -- --host 0.0.0.0 --port ${VITE_DEV_PORT}"]
